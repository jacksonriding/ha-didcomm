# HTTPS URL remote agents use to reach the TLS proxy on this machine.
ACAPY_PUBLIC_ENDPOINT=https://home.example:8443
TLS_PORT=8443
TLS_CERT_PATH=./certs/fullchain.pem
TLS_KEY_PATH=./certs/privkey.pem
ACAPY_LABEL=ha-didcomm-home

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ACAPY_WALLET_KEY=replace-with-a-random-wallet-key
ACAPY_ADMIN_API_KEY=replace-with-another-random-secret

# Home Assistant Container URL as reached from the gateway container.
HA_BASE_URL=http://host.docker.internal:8123
HA_TOKEN=replace-with-a-home-assistant-long-lived-access-token

HOME_ID=my-home
HOME_ISSUER_DID=did:key:replace-with-a-did-created-on-the-home-agent
LOG_LEVEL=info
