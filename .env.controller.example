# URL at which the home agent can reach this controller's DIDComm listener.
# A LAN URL is suitable only on a trusted home network; use HTTPS when routed
# beyond it. Keep the port in sync with CONTROLLER_PORT.
CONTROLLER_PUBLIC_ENDPOINT=http://192.168.1.20:8010
CONTROLLER_PORT=8010
CONTROLLER_LABEL=alice-controller

# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
CONTROLLER_WALLET_KEY=replace-with-a-random-wallet-key
CONTROLLER_ADMIN_API_KEY=replace-with-another-random-secret

# Normally blank. Set this only to select an existing did:key when recovering a
# wallet that already contains multiple key DIDs.
CONTROLLER_HOLDER_DID=
LOG_LEVEL=info
